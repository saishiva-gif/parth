# Databricks — required, backend-only (never referenced from frontend code)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Optional — defaults to clickpost_poc_may_18_v2 if unset
DATABRICKS_CATALOG=clickpost_poc_may_18_v2

# Optional — if set, /api/sync requires `Authorization: Bearer <value>`.
# Vercel Cron sends this automatically when set as a project env var.
CRON_SECRET=
